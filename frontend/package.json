{
  "name": "autolist-next",
  "private": true,
  "version": "1.67.0",
  "description": "AutoList “电影藏馆”界面",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "gen:api": "openapi-typescript openapi.json -o src/api-schema.d.ts",
    "dev": "npm run gen:api && vite",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "typecheck": "npm run gen:api && tsc --noEmit"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
