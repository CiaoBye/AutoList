# 应用对外端口；Compose 只运行本服务一个容器。
APP_PORT=8585
DATA_DIR=/data

# TMDB 为影片识别的必填服务，支持 v3 API Key 或 v4 Read Access Token。
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN
MDBLIST_API_KEY=
COOKIECLOUD_KEY=
COOKIECLOUD_PASSWORD=
COOKIECLOUD_FORWARD_MOVIEPILOT=true

# Transmission 仅用于状态与下载列表诊断；实际提交统一经 MoviePilot 分类。
TR_BASE_URL=http://192.0.2.10:9191
TR_USERNAME=
TR_PASSWORD=

# 可选网络代理；仅在设置中开启相应分流后生效。
OUTBOUND_PROXY_URL=
TMDB_PROXY_ENABLED=false
PT_PROXY_ENABLED=false

# MoviePilot 是必需的下载分类与提交下游，不参与站点搜索。
MP_BASE_URL=http://192.0.2.10:3000
MP_API_KEY=
MP_TIMEOUT_SECONDS=30

# Emby 用于入库状态检查；.strm 会展示但不算实体入库。
EMBY_BASE_URL=
EMBY_API_KEY=

# 可选的 OpenAI 兼容 AI 识别辅助；TMDB 无结果时才会调用。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
